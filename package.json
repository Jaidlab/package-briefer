{
  "name": "package-briefer",
  "version": "0.1.0",
  "type": "module",
  "description": "Serve npm package inspections over HTTP",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaidlab/package-briefer.git"
  },
  "exports": {
    ".": {
      "default": "./src/PackageBrieferServer.ts"
    }
  },
  "bin": {
    "package-briefer": "./src/main.ts"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "test": "bun test --max-concurrency 1 ./test"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/server": "2.0.0",
    "clerc": "1.3.1",
    "inspect-exports": "workspace:*",
    "inspect-npm-package": "workspace:*",
    "lru-cache": "11.5.2",
    "markdownify-inspection": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "eslint": "10.9.1",
    "eslint-config-jaid": "26.0.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4"
  },
  "workspaces": [
    "packages/*"
  ]
}
